{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 20 },
        "company": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "email", "createdAt", "updatedAt"]
    },
    "HoursLog": {
      "title": "HoursLog",
      "description": "Daily hours log for a user",
      "type": "object",
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "normalHours": { "type": "number", "minimum": 0, "maximum": 24 },
        "hasDailyAllowance": { "type": "boolean" },
        "userId": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string" }
      },
      "required": ["date", "normalHours", "hasDailyAllowance", "userId", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/users/{userId}/hoursLog/{logId}": {
      "schema": { "$ref": "#/entities/HoursLog" },
      "description": "Daily hours log for the user"
    }
  }
}
