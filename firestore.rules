rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null && request.auth.token.email_verified == true; }

    function isValidUser(data) {
      return data.keys().hasAll(['name', 'email', 'createdAt', 'updatedAt']) &&
             data.keys().size() <= 6 &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 20)) &&
             (!('company' in data) || (data.company is string && data.company.size() <= 100)) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidHoursLog(data) {
      return data.keys().hasAll(['date', 'normalHours', 'hasDailyAllowance', 'userId', 'updatedAt']) &&
             data.keys().size() == 5 &&
             data.date is string && data.date.size() == 10 && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
             data.normalHours is number && data.normalHours >= 0 && data.normalHours <= 24 &&
             data.hasDailyAllowance is bool &&
             data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
             data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId &&
                       isValidUser(incoming()) &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId &&
                       isValidUser(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'company', 'updatedAt']);

      match /hoursLog/{logId} {
        allow read: if isSignedIn() && isValidId(userId) && isValidId(logId) && request.auth.uid == userId;
        allow list: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
        allow create: if isSignedIn() && isValidId(userId) && isValidId(logId) && request.auth.uid == userId &&
                         isValidHoursLog(incoming()) &&
                         incoming().userId == userId &&
                         incoming().updatedAt == request.time &&
                         exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isSignedIn() && isValidId(userId) && isValidId(logId) && request.auth.uid == userId &&
                         isValidHoursLog(incoming()) &&
                         incoming().userId == userId &&
                         incoming().updatedAt == request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['normalHours', 'hasDailyAllowance', 'updatedAt']);
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(logId) && request.auth.uid == userId;
      }
    }
  }
}
